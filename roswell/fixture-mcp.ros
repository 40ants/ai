#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- "$0" "$@"
|#
(require :asdf)
(let* ((script (or *load-truename* *compile-file-truename*))
       (root (uiop:pathname-parent-directory-pathname
              (uiop:pathname-directory-pathname script))))
  (unless (uiop:getenv "SKILL_EVAL_DEPENDENCY_ROOT")
    (setf (uiop:getenv "SKILL_EVAL_DEPENDENCY_ROOT") (namestring root)))
  (let ((*standard-output* *error-output*) (*trace-output* *error-output*))
    (load (merge-pathnames "nix/lisp-init.lisp" root) :verbose nil :print nil)
    (asdf:initialize-source-registry
     `(:source-registry (:directory ,root) :ignore-inherited-configuration))
    (asdf:load-asd (merge-pathnames "40ants-ai-evals.asd" root))
    (asdf:load-system "40ants-ai-evals/fixture-mcp")))
(uiop:define-package #:40ants-ai-evals/roswell/fixture-mcp
  (:use #:cl)
  (:import-from #:40ants-ai-evals/fixture-mcp #:main))
(in-package #:40ants-ai-evals/roswell/fixture-mcp)
