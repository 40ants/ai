(let* ((a (demo/src/session:make-queue "a"))
       (b (demo/src/session:make-queue "b"))
       (v (vector 8))
       (c (demo/src/session:make-queue "c" :items v)))
  (assert (not (eq (demo/src/session:queue-items a)
                   (demo/src/session:queue-items b))))
  (vector-push-extend 3 (demo/src/session:queue-items a))
  (assert (zerop (length (demo/src/session:queue-items b))))
  (assert (eq v (demo/src/session:queue-items c))))
