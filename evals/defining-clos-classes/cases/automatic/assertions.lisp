(let* ((a (demo/src/session:make-session "/tmp/a"))
       (b (demo/src/session:make-session "/tmp/b" :state :ready)))
  (assert (typep a 'standard-object))
  (assert (null (demo/src/session:session-state a)))
  (assert (eq :ready (demo/src/session:session-state b)))
  (assert (string= "/tmp/b" (demo/src/session:session-project-dir b))))
(let* ((form (definition "src/session.lisp" "defun" "make-session"))
       (args (third form)))
  (assert (member '&rest args))
  (assert (member '&key args))
  (assert (member 'demo/src/session::state args))
  (assert (some (lambda (node)
                  (op-p node "apply"))
                (nodes form))))
