(locally (declare (optimize (safety 3)
                            (debug 3)))
  (let ((a (demo/src/session:make-session "a"))
        (b (demo/src/session:make-session "b" :owner "Ada"))
        (c (demo/src/session:make-session "c" :owner nil)))
    (assert (null (demo/src/session:session-owner a)))
    (assert (string= "Ada" (demo/src/session:session-owner b)))
    (assert (null (demo/src/session:session-owner c)))))
(let* ((class (find-class 'demo/src/session::session))
       (slots (progn (sb-mop:finalize-inheritance class)
                     (sb-mop:class-slots class)))
       (slot (find "OWNER" slots :test #'string= :key (lambda (slot)
                                                        (symbol-name (sb-mop:slot-definition-name slot)))))
       (type (and slot (sb-mop:slot-definition-type slot))))
  (assert slot)
  (assert (subtypep type '(or null string)))
  (assert (typep nil type))
  (assert (typep "Ada" type)))
