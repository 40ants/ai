        "src/json.lisp": "(uiop:define-package #:demo/src/json (:use #:cl) (:export #:roundtrip #:null-field-p #:make-response))\n(in-package #:demo/src/json)\n"
      },
      "environmentProfile": "lisp",
      "scenario": {
        "name": "smoke"
      },
      "checks": [
        {
          "check": "agent/skill-read",
          "params": {
