          }
        },
        {
          "check": "files/preserved",
          "params": {
            "fixtures": {
              "$var": "fixtures"
            },
            "protected": null
          }
        },
        {
          "check": "skill/lisp-runtime",
          "params": {
            "loadFiles": [
              "src/json.lisp"
            ],
            "systems": [
              "yason"
            ],
            "assertions": "(let* ((input \"{\\\"nil\\\":null,\\\"false\\\":false,\\\"empty\\\":[],\\\"items\\\":[1,{\\\"label\\\":\\\"Привет\\\"}]}\")\n               (output (demo/src/json:roundtrip input))\n               (parsed (yason:parse output :json-arrays-as-vectors t :json-booleans-as-symbols t :json-nulls-as-keyword t)))\n          (assert (hash-table-p parsed)) (assert (eq :null (gethash \"nil\" parsed)))\n          (assert (eq 'yason:false (gethash \"false\" parsed)))\n          (assert (equalp #() (gethash \"empty\" parsed)))\n          (assert (string= \"Привет\" (gethash \"label\" (aref (gethash \"items\" parsed) 1)))))"
          }
        }
      ]
    }
