(let* ((input "{\"nil\":null,\"false\":false,\"empty\":[],\"items\":[1,{\"label\":\"Привет\"}]}")
       (output (demo/src/json:roundtrip input))
       (parsed (yason:parse output :json-arrays-as-vectors t :json-booleans-as-symbols t :json-nulls-as-keyword t)))
  (assert (hash-table-p parsed))
  (assert (eq :null (gethash "nil" parsed)))
  (assert (eq 'yason:false (gethash "false" parsed)))
  (assert (equalp #()
                  (gethash "empty" parsed)))
  (assert (string= "Привет" (gethash "label" (aref (gethash "items" parsed) 1)))))
