      "id": "smoke",
      "group": "development",
      "task": "Use $writing-40ants-doc-documentation. Update the main documentation title to \"Demo queue\" while retaining the deterministic queue overview. Rebuild demo-docs with strict default warning settings and verify generated README. This is documentation-only: leave changelog untouched.",
      "shouldTrigger": true,
      "fixtures": "cases/smoke/fixtures/",
      "environmentProfile": "docs",
      "scenario": {
        "name": "smoke"
      },
      "checks": [
        {
          "check": "agent/skill-read",
          "params": {
            "expected": true
          }
        },
        {
          "check": "files/preserved",
          "params": {
            "fixtures": {
              "$var": "fixtures",
              "default": {}
            },
            "protected": null
          }
        },
        {
          "check": "skill/tool-trace",
          "params": {
            "requirements": [
              {
                "pattern": "(?is)(?:[.]qlot/bin/build-docs|docs-builder:build).*demo-docs",
                "output": "(?i)Done",
                "forbiddenOutput": "(?im)^(?:WARNING:|ERROR:|Unhandled |; caught [1-9].*(?:WARNING|ERROR))",
                "forbiddenCommand": "(?is)(?:-e\\s+false|error-on-warnings\\s+nil)"
              }
            ]
          }
        },
        {
          "check": "skill/lisp-runtime",
          "params": {
            "loadFiles": [],
            "systems": [],
            "assertionsFile": "cases/smoke/assertions.lisp"
          }
        },
        {
          "check": "skill/exact-file",
          "params": {
            "file": "docs/changelog.lisp",
            "text": "(uiop:define-package #:demo-docs/changelog (:use #:cl))\n(in-package #:demo-docs/changelog)\n"
          }
        }
      ]
    }
