[
  {
    "description": "smoke: Use $writing-40ants-doc-documentation",
    "vars": {
      "suite": "writing-40ants-doc-documentation",
      "skillName": "writing-40ants-doc-documentation",
      "id": "smoke",
      "group": "development",
      "task": "Use $writing-40ants-doc-documentation. Update the main documentation title to \"Demo queue\" while retaining the deterministic queue overview. Rebuild demo-docs with strict default warning settings and verify generated README. This is documentation-only: leave changelog untouched.",
      "shouldTrigger": true,
      "fixtures": {
        "demo.asd": "(asdf:defsystem \"demo\" :class :package-inferred-system :depends-on (\"demo/src/core\"))\n",
        "src/core.lisp": "(uiop:define-package #:demo/src/core\n  (:use #:cl)\n  (:export #:add)\n)\n(in-package #:demo/src/core)\n(defun add (a b) \"Add two numbers.\" (+ a b))\n",
        "demo-docs.asd": "(asdf:defsystem \"demo-docs\" :class :package-inferred-system :pathname \"docs/\" :depends-on (\"demo\" \"demo-docs/index\"))\n",
        "docs/index.lisp": "(uiop:define-package #:demo-docs/index\n  (:use #:cl)\n  (:import-from #:40ants-doc #:defsection #:defsection-copy)\n  (:export #:@index #:@readme)\n)\n(in-package #:demo-docs/index)\n(40ants-doc:defsection @index (:title \"Demo\")\n  (demo system)\n  \"A deterministic queue for background jobs.\")\n(40ants-doc:defsection-copy @readme @index)\n",
        "docs/changelog.lisp": "(uiop:define-package #:demo-docs/changelog (:use #:cl))\n(in-package #:demo-docs/changelog)\n",
        "README.md": "Old generated readme.\n"
      },
      "environmentProfile": "docs",
      "scenario": {
        "name": "smoke"
      },
      "checks": [
        {
          "check": "agent/skill-read",
          "params": {
            "expected": true
          }
        },
        {
          "check": "files/preserved",
          "params": {
            "fixtures": {
              "$var": "fixtures"
            },
            "protected": null
          }
        },
        {
          "check": "skill/tool-trace",
          "params": {
            "requirements": [
              {
                "pattern": "(?is)(?:[.]qlot/bin/build-docs|docs-builder:build).*demo-docs",
                "output": "(?i)Done",
                "forbiddenOutput": "(?im)^(?:WARNING:|ERROR:|Unhandled |; caught [1-9].*(?:WARNING|ERROR))",
                "forbiddenCommand": "(?is)(?:-e\\s+false|error-on-warnings\\s+nil)"
              }
            ]
          }
        },
        {
          "check": "skill/lisp-runtime",
          "params": {
            "loadFiles": [],
            "systems": [],
            "assertions": "(let ((readme (uiop:read-file-string \"README.md\")))\n(assert (search \"deterministic queue\" readme :test #'char-equal))\n(assert (> (length readme) 100)))\n(assert (search \"Demo queue\" (uiop:read-file-string \"README.md\") :test #'char-equal))"
          }
        },
        {
          "check": "skill/exact-file",
          "params": {
            "file": "docs/changelog.lisp",
            "text": "(uiop:define-package #:demo-docs/changelog (:use #:cl))\n(in-package #:demo-docs/changelog)\n"
          }
        }
      ]
    }
  },
