(asdf:load-asd "demo.asd")
(asdf:load-system "demo")
(let* ((out (make-string-output-stream))
       (*terminal-io* (make-two-way-stream (make-string-input-stream "") out))
       (*debug-io* *terminal-io*))
  (log:config :info :sane :immediate-flush)
  (demo/src/logger:report-path "~/new/~dir")
  (finish-output *terminal-io*)
  (assert (search "~/new/~dir" (get-output-stream-string out))))
(assert (not (some (lambda (node)
                     (and (op-p node "format")
                          (eq (second node) t)))
                   (nodes (forms "src/logger.lisp")))))
