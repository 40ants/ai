[
  {
    "description": "smoke: Use $logging-with-log4cl",
    "vars": {
      "suite": "logging-with-log4cl",
      "skillName": "logging-with-log4cl",
      "id": "smoke",
      "group": "development",
      "task": "Use $logging-with-log4cl. Implement REPORT-PATH(path) in src/logger.lisp to log an info message containing the path literally. Input may contain tildes; keep diagnostics redirectable.",
      "shouldTrigger": true,
      "fixtures": {
        "src/logger.lisp": "(uiop:define-package #:demo/src/logger\n  (:use #:cl)\n  (:export #:report-path #:report-count #:report-error)\n)\n(in-package #:demo/src/logger)\n\n"
      },
      "environmentProfile": "lisp",
      "scenario": {
        "name": "smoke"
      },
      "checks": [
        {
          "check": "agent/skill-read",
          "params": {
            "expected": true
          }
        },
        {
          "check": "files/preserved",
          "params": {
            "fixtures": {
              "$var": "fixtures"
            },
            "protected": null
          }
        },
        {
          "check": "skill/lisp-runtime",
          "params": {
            "loadFiles": [
              "src/logger.lisp"
            ],
            "systems": [
              "log4cl"
            ],
            "assertions": "(let* ((out (make-string-output-stream))\n(*terminal-io* (make-two-way-stream (make-string-input-stream \"\") out))\n(*debug-io* *terminal-io*))\n(log:config :info :sane :immediate-flush)\n(demo/src/logger:report-path \"~/data/~archive/a\")\n(finish-output *terminal-io*)\n(assert (search \"~/data/~archive/a\" (get-output-stream-string out))))\n(assert (not (some (lambda (node) (and (op-p node \"format\") (eq (second node) t)))\n                  (nodes (forms \"src/logger.lisp\")))))"
          }
        }
      ]
    }
  },
