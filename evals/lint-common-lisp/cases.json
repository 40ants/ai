[
  {
    "description": "smoke: Use $lint-common-lisp",
    "vars": {
      "suite": "lint-common-lisp",
      "skillName": "lint-common-lisp",
      "id": "smoke",
      "group": "development",
      "task": "Use $lint-common-lisp. Run both project linters, fix the unused import in demo/src/core with minimal edits, run the applicable test command, and rerun both tools. Do not install dependencies.",
      "shouldTrigger": true,
      "fixtures": {
        "demo.asd": "(asdf:defsystem \"demo\" :class :package-inferred-system :depends-on (\"demo/src/core\") :in-order-to ((asdf:test-op (asdf:test-op \"demo-tests\"))))\n",
        "src/core.lisp": "(uiop:define-package #:demo/src/core\n  (:use #:cl)\n  (:import-from #:cl-ppcre #:scan)\n  (:export #:add)\n)\n(in-package #:demo/src/core)\n(defun add (a b) (+ a b))\n",
        "AGENTS.md": "After source changes run the complete fixture test suite: qlot exec ros run -- --non-interactive --eval '(asdf:test-system \"demo\")' --quit. Do not edit tests or the test-op configuration to mask source failures.\n",
        "demo-tests.asd": "(asdf:defsystem \"demo-tests\" :class :package-inferred-system :pathname \"tests/\" :depends-on (\"rove\" \"demo\" \"demo-tests/core-test\") :perform (asdf:test-op (op system) (declare (ignore op)) (unless (uiop:symbol-call :rove :run system) (error \"Tests failed\"))))\n",
        "tests/core-test.lisp": "(uiop:define-package #:demo-tests/core-test (:use #:cl) (:import-from #:rove #:deftest #:ok) (:import-from #:demo/src/core #:add))\n(in-package #:demo-tests/core-test)\n(deftest add (ok (= 12 (add 5 7))))\n"
      },
      "environmentProfile": "lint",
      "scenario": {
        "name": "smoke"
      },
      "checks": [
        {
          "check": "agent/skill-read",
          "params": {
            "expected": true
          }
        },
        {
          "check": "files/preserved",
          "params": {
            "fixtures": {
              "$var": "fixtures"
            },
            "protected": null
          }
        },
        {
          "check": "skill/tool-trace",
          "params": {
            "requirements": [
              {
                "pattern": "(?is)mallet.*(?:src/core[.]lisp|format)",
                "minimum": 2,
                "forbiddenOutput": "(?im)^(?:WARNING:|ERROR:|Unhandled |; caught [1-9].*(?:WARNING|ERROR))"
              },
              {
                "pattern": "(?is)40ants-linter.*--imports.*(?:-s|--system).*demo",
                "minimum": 2,
                "forbiddenOutput": "(?im)^(?:WARNING:|ERROR:|Unhandled |; caught [1-9].*(?:WARNING|ERROR))"
              }
            ]
          }
        },
        {
          "check": "skill/lisp-runtime",
          "params": {
            "loadFiles": [
              "src/core.lisp"
            ],
            "systems": [],
            "assertions": "(assert (= 12 (demo/src/core:add 5 7)))"
          }
        },
        {
          "check": "skill/tool-trace",
          "params": {
            "requirements": [
              {
                "pattern": "(?is)asdf:test-system.*demo"
              }
            ]
          }
        }
      ]
    }
  },
