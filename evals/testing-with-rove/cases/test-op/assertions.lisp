(asdf:load-asd "demo.asd")
(asdf:load-asd "demo-tests.asd")
(asdf:load-system "demo-tests")
(let ((old (symbol-function 'demo/src/core:positive-count))
      (calls 0))
  (unwind-protect
       (progn
         (setf (symbol-function 'demo/src/core:positive-count)
               (lambda (n)
                 (incf calls)
                 (funcall old n)))
         (asdf:test-system "demo")
         (assert (plusp calls))
         (setf (symbol-function 'demo/src/core:positive-count)
               (lambda (n)
                 (declare (ignore n)) 99))
         (assert (handler-case (progn (asdf:test-system "demo") nil)
                   (error () t))))
    (setf (symbol-function 'demo/src/core:positive-count) old)))
