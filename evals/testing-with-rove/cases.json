[
  {
    "description": "smoke: Use $testing-with-rove",
    "vars": {
      "suite": "testing-with-rove",
      "skillName": "testing-with-rove",
      "id": "smoke",
      "group": "development",
      "task": "Use $testing-with-rove. Add DEFTEST named POSITIVE-COUNT to tests/core-test.lisp testing src/core.lisp valid positive counts and that zero signals DEMO/SRC/CORE:INVALID-COUNT. Use the correct Rove signals argument order.",
      "shouldTrigger": true,
      "fixtures": {
        "src/core.lisp": "(uiop:define-package #:demo/src/core\n  (:use #:cl)\n  (:export #:invalid-count #:positive-count)\n)\n(in-package #:demo/src/core)\n(define-condition invalid-count (error) ())\n(defun positive-count (n) (if (plusp n) n (error 'invalid-count)))\n",
        "tests/core-test.lisp": "(uiop:define-package #:demo-tests/core-test\n  (:use #:cl)\n  (:import-from #:rove #:deftest #:testing #:ok #:signals)\n)\n(in-package #:demo-tests/core-test)\n\n"
      },
      "environmentProfile": "lisp",
      "scenario": {
        "name": "smoke"
      },
      "checks": [
        {
          "check": "agent/skill-read",
          "params": {
            "expected": true
          }
        },
        {
          "check": "files/preserved",
          "params": {
            "fixtures": {
              "$var": "fixtures"
            },
            "protected": null
          }
        },
        {
          "check": "skill/lisp-runtime",
          "params": {
            "loadFiles": [
              "src/core.lisp",
              "tests/core-test.lisp"
            ],
            "systems": [
              "rove"
            ],
            "assertions": "(assert (rove:run-test 'demo-tests/core-test::positive-count))\n(let ((test (definition \"tests/core-test.lisp\" \"deftest\" \"positive-count\")))\n(assert test)\n(assert (some (lambda (node) (and (op-p node \"signals\")\n                                (consp (second node)))) (nodes test))))"
          }
        }
      ]
    }
  },
