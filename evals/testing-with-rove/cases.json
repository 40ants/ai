      "shouldTrigger": true,
      "fixtures": {
        "src/core.lisp": "(uiop:define-package #:demo/src/core\n  (:use #:cl)\n  (:export #:*counter* #:with-temp-counter)\n)\n(in-package #:demo/src/core)\n(global-vars:define-global-var *counter* 41)\n",
        "tests/core-test.lisp": "(uiop:define-package #:demo-tests/core-test\n  (:use #:cl)\n  (:import-from #:rove #:deftest #:testing #:ok #:signals)\n)\n(in-package #:demo-tests/core-test)\n\n"
      },
      "environmentProfile": "lisp",
      "scenario": {
        "name": "global-restoration"
      },
      "checks": [
        {
          "check": "agent/skill-read",
          "params": {
            "expected": true
          }
        },
        {
          "check": "files/preserved",
          "params": {
            "fixtures": {
              "$var": "fixtures"
            },
            "protected": null
          }
        },
        {
          "check": "skill/lisp-runtime",
          "params": {
            "loadFiles": [
              "src/core.lisp",
              "tests/core-test.lisp"
            ],
            "systems": [
              "rove",
              "global-vars"
            ],
            "assertions": "(setf demo/src/core:*counter* 41)\n(assert (= 9 (demo/src/core:with-temp-counter 9 (lambda () demo/src/core:*counter*))))\n(assert (= 41 demo/src/core:*counter*))\n(handler-case (demo/src/core:with-temp-counter 3 (lambda () (error \"expected\"))) (error () nil))\n(assert (= 41 demo/src/core:*counter*))\n(assert (rove:run-test 'demo-tests/core-test::global-state))"
          }
        }
      ]
    }
  },
