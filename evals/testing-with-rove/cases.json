        "tests/core-test.lisp": "(uiop:define-package #:demo-tests/core-test\n  (:use #:cl)\n  (:import-from #:rove #:deftest #:testing #:ok #:signals)\n)\n(in-package #:demo-tests/core-test)\n\n"
