;;;; Archive native workspace evidence before Promptfoo disposes of it.
(uiop:define-package #:40ants-ai-evals/collector
  (:use #:cl)
  (:import-from #:serapeum #:-> #:dict)
  (:import-from #:babel)
  (:import-from #:40ants-ai-evals/util
                #:field #:bool #:decode #:sequence-list #:at #:unique-id
                #:digest-file #:write-text #:write-json #:read-json #:safe-relative-p #:true-p)
  (:import-from #:40ants-ai-evals/agents #:provider-identity)
  (:import-from #:40ants-ai-evals/environments #:finalize)
  (:import-from #:40ants-ai-evals/grading/contracts #:grade)
  (:export #:collect-and-grade))
(in-package #:40ants-ai-evals/collector)

(-> collect-files (pathname &optional t)
    (values hash-table hash-table))
(defun collect-files (workspace &optional artifact-dir)
  "Archive text and binary evidence without opening or traversing symbolic links."
  (unless (uiop:directory-exists-p workspace)
    (error "Missing native workspace: ~A" workspace))
  (let ((files (dict)) (artifacts (dict)))
    (labels ((visit (directory)
               (dolist (entry (sort (uiop:directory* (at directory "*.*") :resolve-symlinks nil)
                                    #'string< :key #'namestring))
                 (let* ((path (string-right-trim "/" (namestring entry)))
                        (relative (enough-namestring path workspace))
                        (name (car (last (uiop:split-string path :separator "/"))))
                        (stat (sb-posix:lstat path)))
                   (unless (or (member name '(".git" ".agents" ".opencode") :test #'equal)
                               (equal relative ".eval-cache/common-lisp"))
                     (unless (safe-relative-p relative)
                       (error "Unconfined evidence path: ~A" relative))
                     (cond
                       ((sb-posix:s-islnk (sb-posix:stat-mode stat))
                        (setf (gethash relative artifacts)
                              (dict "kind" "symlink" "size" (sb-posix:stat-size stat)
                                    "target" (sb-posix:readlink path))))
                       ((sb-posix:s-isdir (sb-posix:stat-mode stat))
                        (visit (uiop:ensure-directory-pathname entry)))
                       ((sb-posix:s-isreg (sb-posix:stat-mode stat))
                        (archive-file path relative (sb-posix:stat-size stat)))
                       (t (error "Unsupported evidence file type: ~A" relative)))))))
             (archive-file (path relative size)
               (when (> size (* 20 1024 1024))
                 (error "Artifact too large: ~A" relative))
               (let* ((bytes (40ants-ai-evals/util::file-octets path))
                      (png (and (>= (length bytes) 24)
                                (equalp (subseq bytes 0 8) #(137 80 78 71 13 10 26 10))))
                      (text (unless (or png (find 0 bytes))
                              (handler-case
                                  (babel:octets-to-string bytes :encoding :utf-8 :errorp t)
                                (error () nil))))
                      (metadata (dict "kind" (cond (png "png") (text "text") (t "binary"))
                                      "size" size "sha256" (digest-file path))))
                 (when png
                   (flet ((uint32 (start)
                            (loop for index from start below (+ start 4)
                                  for value = (aref bytes index)
                                  sum (ash value (* 8 (- (+ start 3) index))))))
                     (setf (gethash "width" metadata) (uint32 16)
                           (gethash "height" metadata) (uint32 20))))
                 (setf (gethash relative artifacts) metadata)
                 (when text
                   (when (> size (* 2 1024 1024))
                     (error "Artifact too large: ~A" relative))
                   (unless (member relative '(".eval-fixture.json" ".eval-environment.json"
                                            ".eval-cache-before.json" "opencode.json")
                                   :test #'equal)
                     (setf (gethash relative files) text)))
                 (when artifact-dir
                   (let ((target (at artifact-dir
                                     (concatenate 'string (if text "files/" "artifacts/") relative))))
                     (ensure-directories-exist target)
                     (with-open-file (stream target :direction :output :if-exists :supersede
                                                    :element-type '(unsigned-byte 8))
                       (write-sequence bytes stream)))))))
      (visit workspace))
    (values files artifacts)))

(-> product-evidence-path-p (string)
    boolean)
(defun product-evidence-path-p (path)
  "Exclude generated harness state from the candidate's change inventory."
  (not (or (member path '(".eval-fixture.json" ".eval-environment.json"
                         ".eval-cache-before.json" "opencode.json"
                         ".eval-evidence" ".eval-cache") :test #'equal)
           (uiop:string-prefix-p ".eval-evidence/" path)
           (uiop:string-prefix-p ".eval-cache/" path)
           (some (lambda (part) (member part '(".git" ".agents" ".opencode") :test #'equal))
                 (uiop:split-string path :separator "/")))))

(-> sample-changes (hash-table hash-table t)
    vector)
(defun sample-changes (files artifacts fixtures)
  "Compare the plain-text fixture baseline with all surviving candidate artifacts."
  (let ((baseline (if (hash-table-p fixtures) fixtures (dict)))
        (paths (make-hash-table :test 'equal))
        (changes nil))
    (dolist (table (list baseline files artifacts))
      (maphash (lambda (path value)
                 (declare (ignore value))
                 (when (product-evidence-path-p path) (setf (gethash path paths) t))) table))
    (dolist (path (sort (loop for path being the hash-keys of paths collect path) #'string<))
      (multiple-value-bind (before existed-before) (gethash path baseline)
        (multiple-value-bind (after text-after) (gethash path files)
          (let* ((exists-after (or text-after (nth-value 1 (gethash path artifacts))))
                 (status (cond ((not existed-before) "added")
                               ((not exists-after) "deleted")
                               ((not (and text-after (equal before after))) "modified"))))
            (when status (push (dict "path" path "status" status) changes))))))
    (coerce (nreverse changes) 'vector)))

(-> normalized-tool-call (hash-table)
    hash-table)
(defun normalized-tool-call (call)
  "Keep completed native tool calls in a provider-independent evidence shape."
  (let* ((type (field call "type"))
         (name (or (field call "name") (field call "tool")
                   (when (equal type "command_execution") "shell")))
         (status (field call "status"))
         (exit-code (find-if #'numberp
                             (list (field call "exit_code") (field call "exitCode")
                                   (field call "exit") (field call "metadata" "exit"))))
         (success (and (or (null exit-code) (zerop exit-code))
                       (not (true-p (field call "result" "isError")))
                       (not (member status '("failed" "error" "in_progress") :test #'equal))
                       (multiple-value-bind (value present) (gethash "success" call)
                         (if present (true-p value)
                             (and (not (true-p (field call "is_error")))
                                  (not (present-error-p (field call "error")))
                                  (or (equal status "completed") (eql 0 exit-code)))))))
         (result (dict "name" name
                       "arguments" (or (field call "arguments") (field call "input")
                                       (when (field call "command")
                                         (dict "command" (field call "command"))) :null)
                       "result" (or (field call "result") (field call "output")
                                    (field call "aggregated_output") :null)
                       "success" (bool success))))
    (when (field call "id") (setf (gethash "id" result) (field call "id")))
    (when (field call "error") (setf (gethash "error" result) (field call "error")))
    (when exit-code (setf (gethash "exitCode" result) exit-code))
    result))

(-> present-error-p (t)
    t)
(defun present-error-p (value)
  (and value (not (eq value :null)) (not (eq value 'yason:false))))

(-> provider-tool-calls (hash-table t)
    vector)
(defun provider-tool-calls (response turn)
  (multiple-value-bind (native present) (gethash "toolCalls" (or (field response "metadata") (dict)))
    (let ((calls (if present (sequence-list native)
                     (remove-if-not
                      (lambda (item)
                        (member (field item "type")
                                '("mcp_tool_call" "tool_call" "function_call" "command_execution")
                                :test #'equal))
                      (sequence-list (field turn "items"))))))
      (coerce (mapcar #'normalized-tool-call calls) 'vector))))

(-> provider-trace (hash-table string string)
    t)
(defun provider-trace (response agent run-dir)
  (if (equal agent "opencode")
      (let ((path (field response "metadata" "tracePath")))
        (unless (and (stringp path) (probe-file path)
                     (uiop:subpathp (truename path)
                                    (uiop:ensure-directory-pathname (truename run-dir))))
          (error "Missing or unconfined OpenCode trace: ~A" path))
        (read-json path))
      (let ((raw (field response "raw")))
        (if (stringp raw) (decode raw) raw))))

(-> provider-statistics (hash-table t string &optional string)
    hash-table)
(defun provider-statistics (response turn agent &optional (skill-name "writing-common-lisp"))
  (let ((metadata (field response "metadata")))
    (if (equal agent "opencode")
        (dict "skillRead" (bool (if (field metadata "skillNames")
                                  (member skill-name (sequence-list (field metadata "skillNames"))
                                          :test #'equal)
                                  (and (equal skill-name (or (field metadata "skillName")
                                                             "writing-common-lisp"))
                                       (true-p (field metadata "skillRead")))))
              "commandCount" (or (field metadata "commandCount") :null)
              "usage" (or (field metadata "usage") :null)
              "usageScope" "session" "durationMs" (or (field metadata "durationMs") :null))
        (let ((items (field turn "items")))
          (unless (and (vectorp items) (not (stringp items)))
            (error "Missing native Codex turn items: ~A" (field response "sessionId")))
          (dict "skillRead"
                (bool (some (lambda (call)
                              (and (equal (field call "name") skill-name)
                                   (not (true-p (field call "is_error")))
                                   (not (equal (field call "status") "error"))
                                   (multiple-value-bind (success present) (gethash "success" call)
                                     (or (not present) (true-p success)))))
                            (sequence-list (field metadata "skillCalls"))))
                "commandCount" (count "command_execution" (sequence-list items)
                                      :key (lambda (item) (field item "type")) :test #'equal)
                "usage" (or (field turn "usage") :null) "usageScope" "turn")))))

(-> blocked-mcp-error (t)
    (or null string))
(defun blocked-mcp-error (turn)
  "Distinguish an approval-policy rejection from a candidate behavior failure."
  (loop for item in (sequence-list (field turn "items"))
        for message = (field item "error" "message")
        when (and (equal "mcp_tool_call" (field item "type")) (stringp message)
                  (search "MCP tool call requires approval" message))
          return message))

(-> collect-and-grade (hash-table)
    hash-table)
(defun collect-and-grade (request)
  "Archive provider evidence before grading, preserving agent identity and raw traces."
  (unless (eql 1 (field request "protocolVersion"))
    (error "Unsupported adapter protocol: ~A" (field request "protocolVersion")))
  (let* ((context (field request "context")) (vars (field context "vars"))
         (response (field context "providerResponse")) (metadata (field response "metadata"))
         (workspace (field metadata "workingDir")) (run-dir (field request "runDir"))
         (label (field context "provider" "label")) (case-id (field vars "id"))
         (skill-name (or (field vars "skillName") "writing-common-lisp")))
    (unless (and (stringp workspace) (stringp run-dir)
                 (stringp label) (stringp skill-name) (stringp case-id) (safe-relative-p case-id))
      (error "Missing or invalid workspace/run/case/provider context: ~A" case-id))
    (multiple-value-bind (label-agent label-variant) (provider-identity label)
      (let* ((agent (or (field metadata "agent") label-agent))
             (variant (or (field metadata "variant") label-variant)))
        (unless (and (member agent '("codex" "opencode") :test #'equal)
                     (member variant '("with-skill" "without-skill") :test #'equal))
          (error "Invalid agent or skill variant: ~A/~A" agent variant))
        (let* ((turn (provider-trace response agent run-dir))
               (sample-id (format nil "~A-~A-~A-~A" case-id variant agent
                                   (subseq (unique-id) 0 8)))
               (artifact-dir (at run-dir (format nil "samples/~A/" sample-id)))
               (statistics (provider-statistics response turn agent skill-name))
               (environment-error nil))
          (when (probe-file (at workspace ".eval-fixture.json"))
            (handler-case
                (progn
                  (unless (sb-posix:s-isreg
                           (sb-posix:stat-mode (sb-posix:lstat
                                               (namestring (at workspace ".eval-fixture.json")))))
                    (error "Environment descriptor must be a regular file"))
                  (setf (gethash "environment" statistics)
                        (finalize workspace :vars vars :archive-directory artifact-dir)))
              (error (condition)
                (setf environment-error (princ-to-string condition)))))
          (setf (gethash "skillName" statistics) skill-name
                (gethash "suite" statistics) (or (field vars "suite") "writing-common-lisp")
                (gethash "toolCalls" statistics) (provider-tool-calls response turn)
                (gethash "sampleId" statistics) sample-id
                (gethash "case" statistics) case-id (gethash "agent" statistics) agent
                (gethash "variant" statistics) variant
                (gethash "sessionId" statistics) (or (field response "sessionId") :null)
                (gethash "final" statistics) (field request "output")
                (gethash "trace" statistics) (format nil "samples/~A/turn.json" sample-id))
          (let ((sample (copy-hash-table* statistics)))
            (multiple-value-bind (files artifacts)
                (collect-files (uiop:ensure-directory-pathname workspace) artifact-dir)
              (let ((changes (sample-changes files artifacts (field vars "fixtures"))))
                (setf (gethash "files" sample) files
                      (gethash "artifacts" sample) artifacts
                      (gethash "changes" sample) changes
                      (gethash "changes" statistics) changes)))
            (write-json (at artifact-dir "turn.json") turn)
            (write-text (at artifact-dir "prompt.txt") (or (field context "prompt") ""))
            (write-json (at artifact-dir "sample.json") sample)
            (handler-case
                (let ((failure (field response "error")))
                  (when environment-error (error "Environment verification failed: ~A" environment-error))
                  (let ((blocked (blocked-mcp-error turn)))
                    (when blocked (error "MCP environment approval policy rejected the tool: ~A" blocked)))
                  (when (and (stringp failure) (plusp (length failure)))
                    (error "Provider failed: ~A" failure))
                  (let ((result (grade sample vars)))
                    (write-json (at artifact-dir "grading.json") result)
                    (dict "protocolVersion" 1 "grading" result "sample" statistics)))
              (error (condition)
                (let ((message (princ-to-string condition)))
                  (setf (gethash "infrastructureError" statistics) message
                        (gethash "infrastructureError" sample) message)
                  (write-json (at artifact-dir "sample.json") sample)
                  (write-json (at artifact-dir "grading-error.json") (dict "error" message))
                  (dict "protocolVersion" 1 "infrastructureError" message
                        "sample" statistics))))))))))

(-> copy-hash-table* (hash-table)
    hash-table)
(defun copy-hash-table* (source)
  (let ((result (dict)))
    (maphash (lambda (key value) (setf (gethash key result) value)) source)
    result))
