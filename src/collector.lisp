;;;; Archive native workspace evidence before Promptfoo disposes of it.
(uiop:define-package #:40ants-ai-evals/src/collector
  (:use #:cl)
  (:import-from #:serapeum #:-> #:dict)
  (:import-from #:40ants-ai-evals/src/util
                #:field #:bool #:decode #:sequence-list #:at #:unique-id
                #:tree-files #:write-text #:write-json #:safe-relative-p)
  (:import-from #:40ants-ai-evals/src/grading/contracts #:grade)
  (:export #:collect-and-grade))
(in-package #:40ants-ai-evals/src/collector)

(-> collect-files (pathname)
    hash-table)
(defun collect-files (workspace)
  (unless (uiop:directory-exists-p workspace)
    (error "Missing native workspace: ~A" workspace))
  (let ((files (dict)))
    (dolist (relative (tree-files workspace :exclude '(".git" ".agents")))
      (let ((file (at workspace relative)))
        (with-open-file (stream file :element-type '(unsigned-byte 8))
          (when (> (file-length stream) (* 2 1024 1024))
            (error "Artifact too large: ~A" relative)))
        (setf (gethash relative files) (uiop:read-file-string file :external-format :utf-8))))
    files))

(-> collect-and-grade (hash-table)
    hash-table)
(defun collect-and-grade (request)
  "Archive a native provider response and return grading plus sample metadata."
  (unless (eql 1 (field request "protocolVersion"))
    (error "Unsupported adapter protocol: ~A" (field request "protocolVersion")))
  (let* ((context (field request "context"))
         (vars (field context "vars"))
         (response (field context "providerResponse"))
         (metadata (field response "metadata"))
         (workspace (field metadata "workingDir"))
         (run-dir (field request "runDir"))
         (variant (field context "provider" "label"))
         (case-id (field vars "id")))
    (unless (and (stringp workspace) (stringp run-dir)
                 (stringp variant) (safe-relative-p variant)
                 (stringp case-id) (safe-relative-p case-id))
      (error "Missing or invalid workspace/run/case/variant context: ~A" case-id))
    (let* ((turn (if (stringp (field response "raw"))
                     (decode (field response "raw")) (field response "raw")))
           (items (field turn "items"))
           (sample-id (format nil "~A-~A-~A" case-id variant (subseq (unique-id) 0 8)))
           (artifact-dir (at run-dir (format nil "samples/~A/" sample-id)))
           (files (collect-files (uiop:ensure-directory-pathname workspace)))
           (statistics
             (dict "sampleId" sample-id "variant" variant
                   "skillRead" (bool (some (lambda (call)
                                             (equal (field call "name") "writing-common-lisp"))
                                           (sequence-list (field metadata "skillCalls"))))
                   "commandCount" (count "command_execution" (sequence-list items)
                                         :key (lambda (item) (field item "type")) :test #'equal)
                   "usage" (or (field turn "usage") (dict))
                   "final" (field request "output")
                   "trace" (format nil "samples/~A/turn.json" sample-id)))
           (sample (copy-hash-table* statistics)))
      (unless (and (vectorp items) (not (stringp items)))
        (error "Missing native Codex turn items: ~A" sample-id))
      (setf (gethash "files" sample) files)
      (maphash (lambda (relative content)
                 (write-text (at artifact-dir (concatenate 'string "files/" relative)) content))
               files)
      (write-json (at artifact-dir "turn.json") turn)
      (write-text (at artifact-dir "prompt.txt") (or (field context "prompt") ""))
      (write-json (at artifact-dir "sample.json") sample)
      (handler-case
          (let ((result (grade sample vars)))
            (write-json (at artifact-dir "grading.json") result)
            (dict "protocolVersion" 1 "grading" result "sample" statistics))
        (error (condition)
          (let ((message (princ-to-string condition)))
            (setf (gethash "infrastructureError" statistics) message)
            (write-json (at artifact-dir "grading-error.json") (dict "error" message))
            (dict "protocolVersion" 1 "infrastructureError" message "sample" statistics)))))))

(-> copy-hash-table* (hash-table)
    hash-table)
(defun copy-hash-table* (source)
  (let ((result (dict)))
    (maphash (lambda (key value) (setf (gethash key result) value)) source)
    result))
