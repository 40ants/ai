;;;; Preserve native timeout evidence before an isolated provider workspace expires.
(uiop:define-package #:40ants-ai-evals/recovery
  (:use #:cl)
  (:import-from #:serapeum #:-> #:dict)
  (:import-from #:40ants-ai-evals/collector)
  (:import-from #:40ants-ai-evals/environments #:finalize)
  (:import-from #:40ants-ai-evals/agents #:provider-identity)
  (:import-from #:40ants-ai-evals/util
                #:field #:at #:bool #:true-p #:read-json #:write-json #:write-text
                #:sequence-list #:safe-relative-p #:unique-id #:copy-directory #:digest-file #:tree-files)
  (:export #:capture #:recover))
(in-package #:40ants-ai-evals/recovery)

(-> capture (t t hash-table t t t)
    hash-table)
(defun capture (workspace provider-dir vars normalized trace-path failure)
  "Archive one native provider workspace independently of Promptfoo's deadline.
VARS must contain its exact ID and variant. Credentials and server state are never
copied: only the sample workspace and an already saved confined provider trace."
  (let* ((case-id (field vars "id")) (variant (field vars "variant"))
         (sample-id (format nil "~A-~A-opencode-~A" case-id variant
                            (subseq (unique-id) 0 8)))
         (snapshot (dict "schemaVersion" 1 "sampleId" sample-id
                         "case" case-id "agent" "opencode" "variant" variant
                         "suite" (or (field vars "suite") "writing-common-lisp")
                         "skillName" (or (field vars "skillName") "writing-common-lisp")
                         "sessionId" (or (field normalized "sessionId") :null)
                         "durationMs" (or (field normalized "durationMs") :null)
                         "skillRead" (bool (true-p (field normalized "skillRead")))
                         "commandCount" (or (field normalized "commandCount") :null)
                         "toolCalls" (or (field normalized "toolCalls") #())
                         "usage" (or (field normalized "usage") :null)
                         "usageScope" "session"
                         "final" (or (field normalized "output") "")
                         "available" (bool nil)))
         (capture-errors nil))
    (handler-case
        (progn
          (unless (and (stringp case-id) (safe-relative-p case-id)
                       (member variant '("with-skill" "without-skill") :test #'equal))
            (error "Missing exact case/variant identity for provider evidence"))
          (unless (and workspace (uiop:directory-exists-p workspace))
            (error "Provider workspace is unavailable"))
          (when (probe-file (at workspace ".eval-fixture.json"))
            (handler-case
                (progn
                  (unless (sb-posix:s-isreg
                           (sb-posix:stat-mode (sb-posix:lstat
                                               (namestring (at workspace ".eval-fixture.json")))))
                    (error "Environment descriptor must be a regular file"))
                  (setf (gethash "environment" snapshot)
                        (finalize workspace :vars vars :archive-directory provider-dir)))
              (error (condition) (push (princ-to-string condition) capture-errors))))
          (multiple-value-bind (files artifacts)
              (40ants-ai-evals/collector::collect-files
               (uiop:ensure-directory-pathname workspace) provider-dir)
            (setf (gethash "files" snapshot) files
                  (gethash "artifacts" snapshot) artifacts
                  (gethash "changes" snapshot)
                  (40ants-ai-evals/collector::sample-changes files artifacts (field vars "fixtures"))
                  (gethash "available" snapshot) (bool t)))
          (when (and trace-path (probe-file trace-path))
            (unless (uiop:subpathp (truename trace-path)
                                  (uiop:ensure-directory-pathname (truename provider-dir)))
              (error "Provider trace is outside its evidence directory"))
            (setf (gethash "sourceTrace" snapshot) (enough-namestring trace-path provider-dir))
            (unless (stringp (field normalized "sessionId"))
              (setf (gethash "sessionId" snapshot)
                    (or (field (read-json trace-path) "session" "data" "id") :null)))))
      (error (condition) (push (princ-to-string condition) capture-errors)))
    (when failure (setf (gethash "infrastructureError" snapshot) failure))
    (when capture-errors
      (setf (gethash "captureError" snapshot) (format nil "~{~A~^; ~}" (reverse capture-errors))))
    (write-json (at provider-dir "evidence.json") snapshot)
    snapshot))

(-> result-identity (hash-table)
    (values t t t))
(defun result-identity (result)
  (let ((label (or (field result "provider" "label") (field result "provider" "id"))))
    (when (stringp label)
      (multiple-value-bind (agent variant) (provider-identity label)
        (values (or (field result "testCase" "vars" "id") (field result "vars" "id"))
                agent variant)))))

(-> provider-failure (hash-table)
    t)
(defun provider-failure (result)
  (or (let ((error (field result "response" "error")))
        (when (and (stringp error) (plusp (length error))) error))
      (when (eql 2 (field result "failureReason"))
        (let ((message (field result "error")))
          (if (stringp message) message "Provider execution failed")))))

(-> validate-artifacts (hash-table t)
    t)
(defun validate-artifacts (snapshot source)
  "Validate archived bytes before publishing a timeout sample. Never follow links."
  (dolist (directory '("files/" "artifacts/"))
    (when (uiop:directory-exists-p (at source directory)) (tree-files (at source directory))))
  (let ((artifacts (field snapshot "artifacts")))
    (unless (and (hash-table-p artifacts) (hash-table-p (field snapshot "files")))
      (error "Provider artifact inventory is unavailable"))
    (maphash
     (lambda (relative metadata)
       (unless (and (stringp relative) (safe-relative-p relative))
         (error "Unconfined recovered artifact path"))
       (unless (equal "symlink" (field metadata "kind"))
         (let* ((path (at source (concatenate 'string
                                             (if (equal "text" (field metadata "kind"))
                                                 "files/" "artifacts/") relative)))
                (stat (sb-posix:lstat (namestring path))))
           (unless (and (sb-posix:s-isreg (sb-posix:stat-mode stat))
                        (eql (sb-posix:stat-size stat) (field metadata "size"))
                        (equal (digest-file path) (field metadata "sha256")))
             (error "Recovered artifact bytes do not match inventory: ~A" relative))))) artifacts))
  t)

(-> publish-snapshot (hash-table t t string)
    hash-table)
(defun publish-snapshot (snapshot source run-dir failure)
  (validate-artifacts snapshot source)
  (let* ((sample-id (field snapshot "sampleId"))
         (target (at run-dir (format nil "samples/~A/" sample-id)))
         (sample (40ants-ai-evals/collector::copy-hash-table* snapshot))
         (stats (40ants-ai-evals/collector::copy-hash-table* snapshot))
         (trace (field snapshot "sourceTrace")))
    (unless (and (stringp sample-id) (safe-relative-p sample-id)
                 (not (find #\/ sample-id)))
      (error "Invalid recovered sample identity"))
    (dolist (directory '("files/" "artifacts/" ".eval-evidence/"))
      (when (uiop:directory-exists-p (at source directory))
        (copy-directory (at source directory) (at target directory))))
    (let ((raw (if (and (stringp trace) (safe-relative-p trace) (probe-file (at source trace)))
                   (read-json (at source trace))
                   (dict "recoveredTraceUnavailable" (bool t)))))
      (write-json (at target "turn.json") raw))
    (setf (gethash "infrastructureError" sample) failure
          (gethash "infrastructureError" stats) failure
          (gethash "recovered" sample) (bool t)
          (gethash "recovered" stats) (bool t)
          (gethash "trace" sample) (format nil "samples/~A/turn.json" sample-id)
          (gethash "trace" stats) (field sample "trace"))
    (dolist (key '("files" "artifacts" "sourceTrace")) (remhash key stats))
    (write-json (at target "sample.json") sample)
    (write-json (at target "grading-error.json") (dict "error" failure "recovered" (bool t)))
    stats))

(-> recover (t)
    hash-table)
(defun recover (run-dir)
  "Enrich local failed export rows from exact, unambiguous provider snapshots.
Original scores, success flags and Promptfoo's database are never modified."
  (let ((export-path (at run-dir "results.json")) (snapshots nil)
        (recovered 0) (unavailable 0) (changed nil) (used (make-hash-table :test 'equal)))
    (unless (probe-file export-path)
      (return-from recover (dict "recovered" 0 "unavailable" 0)))
    (when (uiop:directory-exists-p (at run-dir "opencode/"))
      (dolist (directory (sort (uiop:subdirectories (at run-dir "opencode/")) #'string< :key #'namestring))
        (let ((path (at directory "evidence.json")))
          (when (probe-file path)
            (handler-case (push (cons directory (read-json path)) snapshots) (error () nil))))))
    (let* ((export (read-json export-path)) (body (field export "results"))
           (rows (sequence-list (if (hash-table-p body) (field body "results") body))))
      (dolist (result rows)
        (let* ((response (field result "response")) (failure (provider-failure result)))
          (when (and failure (not (stringp (field response "metadata" "skillEval" "sampleId"))))
            (multiple-value-bind (case-id agent variant) (result-identity result)
              (when (and (equal agent "opencode") (stringp case-id))
                (let* ((session (or (field response "sessionId") (field response "metadata" "sessionId")))
                       (matches (remove-if-not
                                 (lambda (entry)
                                   (let ((snapshot (cdr entry)))
                                     (and (not (gethash (namestring (car entry)) used))
                                          (equal case-id (field snapshot "case"))
                                          (equal agent (field snapshot "agent"))
                                          (equal variant (field snapshot "variant"))
                                          (or (not (stringp session))
                                              (equal session (field snapshot "sessionId")))))) snapshots))
                       (entry (when (= 1 (length matches)) (first matches)))
                       (metadata (if (hash-table-p (field response "metadata"))
                                     (field response "metadata") (dict))))
                  (unless (hash-table-p response)
                    (setf response (dict "error" failure)
                          (gethash "response" result) response))
                  (setf (gethash "metadata" response) metadata changed t)
                  (handler-case
                      (progn
                        (unless (and entry (true-p (field (cdr entry) "available")))
                          (error "Native provider evidence is missing, unavailable, or ambiguous"))
                        (setf (gethash "skillEval" metadata)
                              (publish-snapshot (cdr entry) (car entry) run-dir failure)
                              (gethash (namestring (car entry)) used) t)
                        (incf recovered))
                    (error (condition)
                      (incf unavailable)
                      (setf (gethash "recovery" metadata)
                            (dict "available" (bool nil) "case" case-id "agent" agent
                                  "variant" variant "reason" (princ-to-string condition)))))))))))
      (when changed (write-json export-path export)))
    (dict "recovered" recovered "unavailable" unavailable)))
