;;;; Snapshot inputs, prepare fixtures and delegate execution to Promptfoo.
(uiop:define-package #:40ants-ai-evals/runner
  (:use #:cl)
  (:import-from #:40ants-ai-evals/case-resources)
  (:import-from #:asdf)
  (:import-from #:babel)
  (:import-from #:cl-ppcre)
  (:import-from #:ironclad)
  (:import-from #:yason)
  (:import-from #:40ants-ai-evals/suites #:find-suite #:selected-suites #:suite-path)
  (:import-from #:40ants-ai-evals/environments)
  (:import-from #:40ants-ai-evals/checks)
  (:import-from #:40ants-ai-evals/collector)
  (:import-from #:40ants-ai-evals/recovery)
  (:import-from #:40ants-ai-evals/grading/contracts)
  (:import-from #:40ants-ai-evals/providers/opencode)
  (:import-from #:serapeum #:-> #:dict)
  (:import-from #:40ants-ai-evals/util
                #:field #:true-p #:read-json #:write-json #:write-text #:encode
                #:root #:at #:temporary-directory #:remove-directory #:run-command
                #:tree-files #:copy-directory #:digest-tree #:digest-file
                #:unique-id #:now #:sequence-list #:safe-relative-p)
  (:import-from #:40ants-ai-evals/history #:summarize #:print-summary)
  (:import-from #:40ants-ai-evals/agents
                #:selected-agents #:profile-for #:provider-label #:render-task)
  (:export #:run-eval #:replay-run #:validate-options #:grading-vars))
(in-package #:40ants-ai-evals/runner)

(defparameter *skill-path* "plugins/common-lisp-skills/skills/writing-common-lisp/")
(defparameter *suite-path* "evals/writing-common-lisp/")

(-> execute (list &key (:directory t))
    string)
(defun execute (argv &key (directory (root)))
  (string-trim '(#\Space #\Tab #\Return #\Newline)
               (run-command argv :directory directory)))

(-> option (hash-table string string)
    string)
(defun option (flags key default)
  (or (gethash key flags) default))

(-> integer-option (hash-table string integer integer integer)
    integer)
(defun integer-option (flags key default minimum maximum)
  (let ((value (if (gethash key flags) (parse-integer (gethash key flags)) default)))
    (unless (<= minimum value maximum)
      (error "--~A must be ~D..~D" key minimum maximum))
    value))

(-> validate-options (hash-table)
    t)
(defun validate-options (flags)
  "Reject invalid options before creating any run or contacting the model."
  (maphash (lambda (key value)
             (declare (ignore value))
             (unless (member key '("ablation" "label" "model" "effort" "repeat" "group"
                                    "filter" "ref" "skill-dir" "timeout" "agent" "suite") :test #'equal)
               (error "Unknown run option --~A" key))) flags)
  (selected-suites flags)
  (let ((agents (selected-agents flags)))
    (when (and (> (length agents) 1)
               (or (gethash "model" flags) (gethash "effort" flags)))
      (error "--agent all uses per-agent profiles; remove ambiguous --model/--effort: ~A" agents))
    (when (and (equal agents '("opencode")) (gethash "effort" flags))
      (error "--effort applies only to Codex: ~A" (gethash "effort" flags)))
    (when (member "opencode" agents :test #'equal)
      (40ants-ai-evals/providers/opencode:model-reference
       (field (profile-for "opencode" flags) "model"))))
  (integer-option flags "repeat" 1 1 20)
  (integer-option flags "timeout" 240000 1 3600000)
  (unless (member (option flags "group" "development")
                   '("development" "holdout" "all") :test #'equal)
    (error "Invalid group: ~A" (gethash "group" flags)))
  (unless (member (option flags "effort" "medium")
                   '("low" "medium" "high" "xhigh" "max" "ultra") :test #'equal)
    (error "Invalid effort: ~A" (gethash "effort" flags)))
  (when (and (gethash "ref" flags) (gethash "skill-dir" flags))
    (error "Use either --ref or --skill-dir: ~A" (gethash "ref" flags))))

(-> grading-vars (hash-table)
    hash-table)
(defun grading-vars (vars)
  "Apply this suite's declared check defaults, keeping historical expectations intact."
  (let* ((suite (find-suite (field vars "suite")))
         (path (if (field vars "suite") (suite-path (field vars "suite")) *suite-path*))
         (config (read-json (at (at (root) path) "promptfooconfig.json")))
         (result (40ants-ai-evals/checks:merge-vars (field config "defaultTest" "vars") vars)))
    (setf (gethash "suite" result) (field suite "id")
          (gethash "skillName" result) (field suite "skillName")
          (gethash "environmentProfile" result) (field suite "environmentProfile"))
    result))

(-> validate-extension-paths (hash-table)
    t)
(defun validate-extension-paths (vars)
  (dolist (system (sequence-list (field vars "checkSystems")))
    (let ((asd (field system "asd")))
      (when (and asd (not (uiop:string-prefix-p "evals/checks/" asd)))
        (error "Production check extensions must be snapshotted under evals/checks/: ~A" asd)))))

(-> selected-cases (hash-table)
    list)
(defun selected-cases (flags)
  (let* ((group (option flags "group" "development"))
         (pattern (gethash "filter" flags))
         (cases (remove-if-not
                 (lambda (case)
                   (and (or (equal group "all") (equal group (field case "vars" "group")))
                        (or (not pattern) (cl-ppcre:scan pattern (field case "description")))))
                 (sequence-list (read-json (at (at (root) *suite-path*) "cases.json"))))))
    (unless cases (error "No matching cases; refusing an empty eval: ~A" pattern))
    (dolist (case cases)
      (let* ((raw (field case "vars"))
             (suite (find-suite (gethash "suite" flags)))
             (vars (progn (setf (gethash "suite" raw) (field suite "id")) (grading-vars raw))))
        (40ants-ai-evals/case-resources:validate-fixtures vars)
        (validate-extension-paths vars)
        (40ants-ai-evals/checks:validate-plan vars)
        (setf (gethash "vars" case) vars)))
    cases))

(-> version-line (string)
    string)
(defun version-line (output)
  "Ignore logger diagnostics before a tool's final version line."
  (or (car (last (remove "" (mapcar (lambda (line)
                                       (string-trim '(#\Space #\Tab #\Return) line))
                                     (uiop:split-string output :separator '(#\Newline)))
                          :test #'equal))) ""))

(-> tool-versions (&optional list)
    hash-table)
(defun tool-versions (&optional (agents '("codex")))
  (unless (and (uiop:getenv "SKILL_EVAL_TOOLCHAIN_DIR") (uiop:getenv "SKILL_EVAL_TOOL_PATH"))
    (error "Enter the project nix-shell first: ~A" (root)))
  (let ((tools (dict)))
    (dolist (tool (append '("promptfoo" "apm" "sbcl" "node")
                         (when (member "codex" agents :test #'equal) '("codex"))
                         (when (member "opencode" agents :test #'equal) '("opencode"))))
      (setf (gethash tool tools)
            (let ((output (execute (list tool "--version"))))
              (if (equal tool "promptfoo") (version-line output) output))))
    (multiple-value-bind (out err) (run-command '("ros" "--version"))
      (setf (gethash "ros" tools)
            (string-trim '(#\Space #\Tab #\Return #\Newline) (concatenate 'string out err))))
    ;; Qlot 1.8.2 deliberately exits 255 for --version.
    (multiple-value-bind (out err status)
        (run-command '("qlot" "--version") :allow-failure t)
      (unless (member status '(0 255))
        (error "Cannot determine Qlot version (~D): ~A" status err))
      (setf (gethash "qlot" tools)
            (string-trim '(#\Space #\Tab #\Return #\Newline) out)))
    (when (member "codex" agents :test #'equal)
      (setf (gethash "codexSdk" tools)
            (field (read-json (at (uiop:getenv "SKILL_EVAL_TOOLCHAIN_DIR")
                                  "@openai/codex-sdk/package.json")) "version")))
    (setf (gethash "asdfSystem" tools) (asdf:component-version (asdf:find-system "40ants-ai-evals"))
          (gethash "qlfileLockSha256" tools) (digest-file (at (root) "qlfile.lock")))
    (unless (and (equal (field tools "promptfoo") "0.125.1")
                 (or (not (member "codex" agents :test #'equal))
                     (and (search "0.156.1" (field tools "codex"))
                          (equal "0.156.1" (field tools "codexSdk"))))
                 (or (not (member "opencode" agents :test #'equal))
                     (equal (field tools "opencode") "opencode v2.2.1"))
                 (search "0.31.0" (field tools "apm"))
                 (search "26.10.117" (field tools "ros"))
                 (equal "Qlot 1.8.2" (field tools "qlot")))
      (error "Unexpected tool versions; enter project nix-shell: ~A" (encode tools)))
    tools))

(-> snapshot (t hash-table)
    t)
(defun snapshot (run-dir flags)
  (let ((skill (at run-dir "skill/")) (harness (at run-dir "harness/")))
    (if (gethash "ref" flags)
        (let* ((revision (execute (list "git" "rev-parse" "--verify" "--end-of-options"
                                        (format nil "~A^{commit}" (gethash "ref" flags)))))
               (archive (at run-dir "skill.tar"))
               (unpack (at run-dir "git-snapshot/")))
          (ensure-directories-exist (at unpack ".keep"))
          (execute (list "git" "archive" "--format=tar"
                         (format nil "--output=~A" archive) revision *skill-path*))
          (execute (list "tar" "-xf" (namestring archive) "-C" (namestring unpack)))
          (copy-directory (at unpack *skill-path*) skill)
          (delete-file archive)
          (remove-directory unpack))
        (copy-directory (at (root) (option flags "skill-dir" *skill-path*)) skill))
    (dolist (directory '("evals/" "src/" "roswell/" "t/" "nix/"))
      (copy-directory (at (root) directory) (at harness directory) :ignore-editor-locks t))
    ;; Generated HTML is deliberately excluded; Lisp docs supply the system version.
    (dolist (relative (tree-files (at (root) "docs/") :exclude '("build") :ignore-editor-locks t))
      (let ((target (at (at harness "docs/") relative)))
        (ensure-directories-exist target)
        (uiop:copy-file (at (at (root) "docs/") relative) target)))
    (dolist (file '("shell.nix" "qlfile" "qlfile.lock" "README.md"))
      (uiop:copy-file (at (root) file) (at harness file)))
    (dolist (asd (uiop:directory-files (root) "*.asd"))
      (uiop:copy-file asd (at harness (file-namestring asd))))
    harness))

(-> prepare-fixtures (t list list list)
    t)
(defun prepare-fixtures (run-dir cases variants agents)
  (dolist (case cases)
    (let* ((vars (field case "vars")) (id (field vars "id")) (workspaces (dict)))
      (unless (and (stringp id) (safe-relative-p id))
        (error "Invalid case ID: ~A" id))
      (setf (gethash "environmentInstructions" vars)
            (40ants-ai-evals/environments:workspace-instructions))
      (setf (gethash "taskWithoutSkill" vars)
            (cl-ppcre:regex-replace-all
             (format nil "Use \\$~A(?: and follow this project's conventions)?\\.\\s*"
                     (or (field vars "skillName") "writing-common-lisp"))
             (field vars "task") ""))
      (dolist (agent agents)
        (setf (gethash agent workspaces) (dict)
              (gethash (format nil "task_~A" agent) vars) (render-task (field vars "task") agent (or (field vars "skillName") "writing-common-lisp")))
        (dolist (variant variants)
          (let ((workspace (at run-dir (format nil "fixtures/~A/~A/~A/" id agent variant))))
            (ensure-directories-exist (at workspace ".keep"))
            (execute (list "git" "init" "--quiet" (namestring workspace)))
            (40ants-ai-evals/case-resources:copy-fixtures vars workspace)
            (unless (probe-file (at workspace "AGENTS.md"))
              ;; Environment facts only; assertions and skill-specific advice stay
              ;; out of the prompt. Keep copied samples independent of user projects.
              (write-text (at workspace "AGENTS.md")
                          (format nil "# Prepared evaluation workspace~%~%Dependencies and tools are already provisioned by the project Nix shell and Qlot. Run all shell commands through `qlot exec` from this directory; `qlot exec sbcl` loads that pinned Qlot distribution automatically. For a standalone file, load its dependencies and the file directly; use an ASDF project only when its .asd file exists. Lisp dependency sources are under `$SKILL_EVAL_DEPENDENCY_ROOT/.qlot/`; obtain exact paths with ASDF. Do not search or register personal checkouts, user Quicklisp directories, or the whole filesystem. Do not install dependencies or download browsers. Inspect `.eval-environment.json` for fixture-specific paths. Keep work inside this workspace.~%~%Deployment operations use the fixture MCP simulator exclusively. Do not execute real SSH, scp, sftp, sudo or systemctl. Reverse SSH forwarding is forbidden. Ordinary SSH/scp/sftp outside this simulator would require `-o ClearAllForwardings=yes`.~%"))
              (when (equal (field vars "environmentProfile") "playwright")
                (with-open-file (out (at workspace "AGENTS.md") :direction :output :if-exists :append
                                     :external-format :utf-8)
                  (format out "~%The prepared fixture MCP provides `run_browser_smoke` for the exact command `./run_smoke_test.sh`. Use that runner when available: it launches the pinned browser outside the agent's restricted subprocess environment, captures its real exit status, and retains screenshots. Generate the wrapper and Python test normally; the runner does not generate or repair them.~%"))))
            (let ((baseline (40ants-ai-evals/case-resources:fixture-manifest vars)))
              (when (probe-file (at workspace "AGENTS.md"))
                (setf (gethash "AGENTS.md" baseline)
                      (40ants-ai-evals/case-resources:file-metadata (at workspace "AGENTS.md"))))
              (setf (gethash "fixtureManifest" vars) baseline))
            (when (equal variant "with-skill")
              (copy-directory (at run-dir "skill/")
                              (at workspace (format nil "~A/skills/~A/"
                                                    (if (equal agent "codex") ".agents" ".opencode")
                                                    (or (field vars "skillName") "writing-common-lisp")))))
            (when (field vars "suite")
              (let ((descriptor (40ants-ai-evals/environments:prepare workspace vars)))
                (setf (gethash "fixtureScript" descriptor)
                      (namestring (at (at run-dir "harness/") "roswell/fixture-mcp.ros")))
                (write-json (at workspace ".eval-fixture.json") descriptor)))
            (setf (gethash variant (field workspaces agent)) (namestring workspace))
            (when (equal agent "codex")
              (setf (gethash (if (equal variant "with-skill")
                                "workspaceWithSkill" "workspaceWithoutSkill") vars)
                    (namestring workspace))))))
      (setf (gethash "workspaces" vars) workspaces))))

(-> disabled-skills ()
    vector)
(defun disabled-skills ()
  (let ((seen (make-hash-table :test 'equal)) (result nil))
    (labels ((visit (dir)
               (when (uiop:directory-exists-p dir)
                 (let ((real (namestring (truename dir))))
                   (unless (gethash real seen)
                     (setf (gethash real seen) t)
                     (dolist (file (uiop:directory-files dir))
                       (when (string-equal (file-namestring file) "SKILL.md")
                         (push (dict "path" (namestring file) "enabled" 'yason:false) result)))
                     (mapc #'visit (uiop:subdirectories dir)))))))
      (visit (at (user-homedir-pathname) ".agents/skills/"))
      (visit #P"/etc/codex/skills/"))
    (coerce (nreverse result) 'vector)))

(-> codex-provider (hash-table pathname string &optional t)
    hash-table)
(defun codex-provider (profile auth-dir variant &optional (harness (root)))
  (let* ((template (read-json (at (at (root) *suite-path*) "promptfooconfig.json")))
         (provider (aref (field template "providers") 0))
         (settings (field provider "config"))
         (path (uiop:getenv "SKILL_EVAL_TOOL_PATH"))
         (cache (namestring (at auth-dir "cache/")))
         (dependency-root (namestring (root))))
    (setf (gethash "label" provider) (provider-label "codex" variant)
          (gethash "prompts" provider) (vector (provider-label "codex" variant))
          (gethash "model" settings) (field profile "model")
          (gethash "model_reasoning_effort" settings) (field profile "effort")
          (gethash "working_dir" settings)
          (if (equal variant "with-skill") "{{workspaceWithSkill}}" "{{workspaceWithoutSkill}}")
          (gethash "cli_env" settings)
          (dict "PATH" path "CODEX_HOME" (namestring auth-dir) "ZDOTDIR" (namestring auth-dir)
                "XDG_CACHE_HOME" cache "SKILL_EVAL_DEPENDENCY_ROOT" dependency-root)
          (gethash "cli_config" settings)
          (dict "features.memories" 'yason:false "allow_login_shell" 'yason:false
                "skills.config" (disabled-skills)
                "shell_environment_policy.set.PATH" path
                "shell_environment_policy.set.ZDOTDIR" (namestring auth-dir)
                "shell_environment_policy.set.XDG_CACHE_HOME" cache
                "shell_environment_policy.set.SKILL_EVAL_DEPENDENCY_ROOT" dependency-root))
    ;; The native SDK deliberately inherits only a minimal process environment.
    ;; Pass pinned fixture tools explicitly to both the CLI and its shell tools.
    (dolist (name '("ROSWELL_HOME" "PLAYWRIGHT_BROWSER_PATH" "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH"
                    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD" "SKILL_EVAL_PYTHON"
                    "SKILL_EVAL_CHROMIUM_REVISION" "SKILL_EVAL_CHROMIUM_VERSION"
                    "SKILL_EVAL_PLAYWRIGHT_VERSION" "SKILL_EVAL_ENVIRONMENT_NIXPKGS"
                    "SKILL_EVAL_NIXPKGS_PATH" "NIX_PATH" "NIX_SSL_CERT_FILE" "SSL_CERT_FILE"))
      (let ((value (uiop:getenv name)))
        (when value
          (setf (gethash name (gethash "cli_env" settings)) value
                (gethash (concatenate 'string "shell_environment_policy.set." name)
                         (gethash "cli_config" settings)) value))))
    (unless (equal *suite-path* "evals/writing-common-lisp/")
      (let* ((entry (find-suite
                     (car (last (pathname-directory (pathname *suite-path*))))))
             (extra (40ants-ai-evals/environments:codex-config
                     (dict "profile" (field entry "environmentProfile")
                           "fixtureScript" (namestring (at harness "roswell/fixture-mcp.ros"))))))
        (when (equal "playwright" (field entry "environmentProfile"))
          ;; Browser fixtures include an application served on local loopback.
          (setf (gethash "network_access_enabled" settings) 'yason:true))
        (maphash (lambda (key value) (setf (gethash key (gethash "cli_config" settings)) value)) extra)))
    provider))

(-> opencode-execution-timeout (hash-table)
    integer)
(defun opencode-execution-timeout (flags)
  (let ((deadline (integer-option flags "timeout" 240000 1 3600000)))
    (- deadline (min 30000 (floor deadline 4)))))

(-> effective-config (t list hash-table pathname hash-table t)
    pathname)
(defun effective-config (run-dir cases flags auth-dir profiles server)
  (let* ((suite (at (at run-dir "harness/") *suite-path*))
         (config (read-json (at suite "promptfooconfig.json")))
         (variants (if (gethash "ablation" flags)
                       '("with-skill" "without-skill") '("with-skill")))
         (providers nil) (prompts nil))
    (dolist (agent (selected-agents flags))
      (dolist (variant variants)
        (let ((label (provider-label agent variant)))
          (push (dict "id" label "label" label
                      "raw" (format nil "{{environmentInstructions}}~%~%~A"
                                     (if (equal variant "without-skill") "{{taskWithoutSkill}}"
                                         (format nil "{{task_~A}}" agent)))) prompts)
          (push (if (equal agent "codex")
                    (codex-provider (field profiles agent) auth-dir variant (at run-dir "harness/"))
                    (dict "id" "file://../lib/opencode-provider.cjs" "label" label
                          "prompts" (vector label)
                          "config" (dict "runDir" (namestring run-dir) "server" server
                                         "agent" agent "variant" variant
                                         "profile" (field profiles agent)
                                         "timeout" (opencode-execution-timeout flags)
                                         "overallTimeoutMs" (integer-option flags "timeout" 240000 1 3600000))))
                providers))))
    (setf (gethash "prompts" config) (coerce (nreverse prompts) 'vector)
          (gethash "providers" config) (coerce (nreverse providers) 'vector)
          (gethash "tests" config) "file://selected-cases.json")
    (write-json (at suite "selected-cases.json") (coerce cases 'vector))
    (write-json (at suite "effective.json") config)))

(-> manifest (string t hash-table list list hash-table &optional hash-table)
    hash-table)
(defun manifest (id run-dir flags cases variants tools &optional environment)
  (let* ((agents (selected-agents flags)) (profiles (dict))
         (single (when (= 1 (length agents)) (profile-for (first agents) flags tools))))
    (dolist (agent agents)
      (let ((profile (profile-for agent flags tools)))
        (setf (gethash "evaluationTimeoutMs" profile)
              (integer-option flags "timeout" 240000 1 3600000))
        (when (equal agent "opencode")
          (setf (gethash "executionTimeoutMs" profile) (opencode-execution-timeout flags)))
        (setf (gethash agent profiles) profile)))
    (dict "id" id "label" (option flags "label" "unlabelled") "started" (now)
          "suite" (or (gethash "suite" flags) "writing-common-lisp")
          "skillName" (field (find-suite (gethash "suite" flags)) "skillName")
          "environment" (or environment
                            (40ants-ai-evals/environments:preflight
                             (field (find-suite (gethash "suite" flags)) "environmentProfile")))
          "fixturesHash" (40ants-ai-evals/case-resources:input-fingerprint cases :fixtures-only t)
          "inputsHash" (40ants-ai-evals/case-resources:input-fingerprint cases)
          "skillSource" (or (gethash "ref" flags) (gethash "skill-dir" flags) "working-tree")
          "skillHash" (digest-tree (at run-dir "skill/"))
          "suiteHash" (digest-tree (at run-dir "harness/"))
          "gitCommit" (execute '("git" "rev-parse" "HEAD"))
          "gitStatus" (execute '("git" "status" "--porcelain"))
          "agents" (coerce agents 'vector) "profiles" profiles
          "model" (or (field single "model") :null) "effort" (or (field single "effort") :null)
          "repeat" (integer-option flags "repeat" 1 1 20)
          "group" (option flags "group" "development")
          "cases" (map 'vector (lambda (case) (field case "vars" "id")) cases)
          "variants" (coerce variants 'vector) "tools" tools
          "platform" (format nil "~A-~A" (string-downcase (software-type))
                              (string-downcase (machine-type)))
          "timeoutMs" (integer-option flags "timeout" 240000 1 3600000)
          "toolPath" (uiop:getenv "SKILL_EVAL_TOOL_PATH")
          "note" "Compare agent/model systems; pinned clients do not pin server-side model weights.")))

(-> environment-arguments (t t hash-table)
    list)
(defun environment-arguments (run-dir harness info)
  (list "env" (format nil "PROMPTFOO_CONFIG_DIR=~A" (at (root) ".evals/promptfoo/"))
        "PROMPTFOO_DISABLE_TELEMETRY=1" "PROMPTFOO_DISABLE_UPDATE=1"
        (format nil "SKILL_EVAL_RUN_DIR=~A" run-dir)
        (format nil "SKILL_EVAL_HARNESS_ROOT=~A" harness)
        (format nil "SKILL_EVAL_DEPENDENCY_ROOT=~A" (root))
        (format nil "PROMPTFOO_EVAL_TIMEOUT_MS=~D" (field info "timeoutMs"))))

(-> archive-provider-errors (pathname)
    t)
(defun archive-provider-errors (run-dir)
  "Archive partial provider failures even when Promptfoo skips assertions.
Only the local export is enriched; Promptfoo's database is left untouched."
  (let ((file (at run-dir "results.json")))
    (when (probe-file file)
      (let* ((export (read-json file)) (body (field export "results"))
             (results (if (hash-table-p body) (field body "results") body)))
        (dolist (result (sequence-list results))
          (let* ((response (field result "response")) (metadata (field response "metadata"))
                 (failure (field response "error")))
            (when (and (stringp failure) (field metadata "workingDir")
                       (not (field metadata "skillEval")))
              (handler-case
                  (let* ((vars (or (field result "testCase" "vars") (field result "vars")))
                         (answer (40ants-ai-evals/collector:collect-and-grade
                                  (dict "protocolVersion" 1 "runDir" (namestring run-dir)
                                        "output" (field response "output")
                                        "context" (dict "vars" vars "providerResponse" response
                                                        "provider" (field result "provider")
                                                        "prompt" (or (field result "prompt" "raw") ""))))))
                    (setf (gethash "skillEval" metadata) (field answer "sample")))
                (error (condition)
                  (setf (gethash "skillEval" metadata)
                        (dict "agent" (field metadata "agent") "variant" (field metadata "variant")
                              "infrastructureError" (princ-to-string condition))))))))
        (write-json file export)))))

(-> run-single-eval (hash-table)
    integer)
(defun run-single-eval (flags)
  "Snapshot a run and evaluate selected agent profiles on the same check plans."
  (validate-options flags)
  (let* ((cases (selected-cases flags)) (agents (selected-agents flags))
         (environment (40ants-ai-evals/environments:preflight
                       (field (find-suite (gethash "suite" flags)) "environmentProfile")))
         (inputs-hash (40ants-ai-evals/case-resources:input-fingerprint cases))
         (tools (tool-versions agents))
         (id (format nil "~A-~A" (substitute #\- #\. (substitute #\- #\: (now)))
                     (subseq (unique-id) 0 6)))
         (run-dir (at (root) (format nil ".evals/runs/~A/" id)))
         (variants (if (gethash "ablation" flags)
                       '("with-skill" "without-skill") '("with-skill")))
         (auth-dir (temporary-directory "cl-eval-auth")) (server nil))
    (unwind-protect
         (progn
           (ensure-directories-exist (at run-dir ".keep"))
           (let* ((harness (snapshot run-dir flags))
                  (40ants-ai-evals/case-resources:*inputs-root* harness)
                  (snapshot-hash (40ants-ai-evals/case-resources:input-fingerprint cases))
                  (info (progn
                          (unless (equal inputs-hash snapshot-hash)
                            (error "Case inputs changed after preflight; refusing model calls"))
                          (manifest id run-dir flags cases variants tools environment)))
                  (auth (at (or (uiop:getenv "CODEX_HOME")
                                 (at (user-homedir-pathname) ".codex/")) "auth.json"))
                  (status 1))
             (when (and (member "codex" agents :test #'equal) (probe-file auth))
               (execute (list "ln" "-s" (namestring auth)
                              (namestring (at auth-dir "auth.json")))))
             (prepare-fixtures run-dir cases variants agents)
             (write-json (at run-dir "manifest.json") info)
             (format t "Running ~D cases x ~D repeats x ~D variants x ~D agents~%Run: ~A~%"
                     (length cases) (field info "repeat") (length variants) (length agents) id)
             (format t "Progress log: ~A~%" (at run-dir "promptfoo.stdout.log"))
             (finish-output)
             (handler-case
                 (progn
                   (when (member "opencode" agents :test #'equal)
                     (setf server (40ants-ai-evals/providers/opencode:start-server run-dir)))
                   (let* ((config (effective-config run-dir cases flags auth-dir
                                                    (field info "profiles") server))
                          (args (append (environment-arguments run-dir harness info)
                                        (list "promptfoo" "eval" "-c" (namestring config)
                                              "-o" (namestring (at run-dir "results.json"))
                                              "--no-cache" "--no-share" "--no-table"
                                              "--repeat" (princ-to-string (field info "repeat"))
                                              "--max-concurrency" "1"))))
                     (setf status
                           (nth-value 2
                             (run-command args :allow-failure t
                               :timeout (+ 180 (* (length cases) (length variants)
                                                 (length agents) (field info "repeat")
                                                 (+ 60 (/ (field info "timeoutMs") 1000))))
                               :log-prefix (at run-dir "promptfoo"))))))
               (error (condition)
                 (write-text (at run-dir "promptfoo.spawn-error.log")
                             (princ-to-string condition))))
             (40ants-ai-evals/recovery:recover run-dir)
             (archive-provider-errors run-dir)
             (let ((summary (summarize run-dir info status)))
               (print-summary summary)
               (if (and (zerop status) (true-p (field summary "coverageComplete"))
                        (every (lambda (row) (true-p (field row "pass")))
                               (sequence-list (field summary "rows")))) 0 1))))
      (when server (40ants-ai-evals/providers/opencode:stop-server server))
      (remove-directory auth-dir))))

(-> grader-fingerprint ()
    string)
(defun grader-fingerprint ()
  (let ((hashes (dict)))
    (dolist (dir '("src/" "evals/checks/" "roswell/"))
      (setf (gethash dir hashes) (digest-tree (at (root) dir))))
    (dolist (file '("docs/changelog.lisp" "qlfile.lock" "evals/suites.json"))
      (when (probe-file (at (root) file))
        (setf (gethash file hashes) (digest-file (at (root) file)))))
    (dolist (entry (40ants-ai-evals/suites:catalog))
      (let ((file (field entry "config")))
        (when (probe-file (at (root) file))
          (setf (gethash file hashes) (digest-file (at (root) file))))
        (setf (gethash (concatenate 'string (field entry "id") "/inputs") hashes)
              (digest-tree (at (root) (suite-path (field entry "id")))))))
    (dolist (asd (uiop:directory-files (root) "*.asd"))
      (setf (gethash (file-namestring asd) hashes) (digest-file asd)))
    (ironclad:byte-array-to-hex-string
     (ironclad:digest-sequence :sha256 (babel:string-to-octets (encode hashes) :encoding :utf-8)))))

(-> archive-integrity-error (hash-table pathname)
    (or null string))
(defun archive-integrity-error (sample sample-dir)
  "Check persisted artifact bytes before offline grading, without following links."
  (let ((artifacts (field sample "artifacts")))
    (when (hash-table-p artifacts)
      (block invalid
        (maphash
         (lambda (relative metadata)
           (unless (safe-relative-p relative)
             (return-from invalid (format nil "Unsafe archived artifact path: ~A" relative)))
           (unless (equal "symlink" (field metadata "kind"))
             (let* ((prefix (if (equal "text" (field metadata "kind")) "files/" "artifacts/"))
                    (path (at sample-dir (concatenate 'string prefix relative))))
               (unless (probe-file path)
                 (return-from invalid (format nil "Missing archived artifact: ~A" relative)))
               (let ((stat (sb-posix:lstat (namestring path))))
                 (unless (and (sb-posix:s-isreg (sb-posix:stat-mode stat))
                              (= (sb-posix:stat-size stat) (field metadata "size"))
                              (equal (digest-file path) (field metadata "sha256"))
                              (or (not (nth-value 1 (gethash "executableBits" metadata)))
                                  (= (logand #o111 (sb-posix:stat-mode stat))
                                     (field metadata "executableBits"))))
                   (return-from invalid (format nil "Corrupt archived artifact: ~A" relative)))))))
         artifacts)
        nil))))

(-> unavailable-native-results-p (hash-table)
    boolean)
(defun unavailable-native-results-p (sample)
  "Detect old successful private MCP calls whose native results were not archived."
  (not (null
        (some (lambda (call)
                (and (true-p (field call "success"))
                     (member (field call "name")
                             '("eval_lisp_form" "remote_shell" "run_browser_smoke") :test #'equal)
                     (or (not (field call "result")) (eq :null (field call "result")))))
              (sequence-list (field sample "toolCalls"))))))

(-> replay-run (t)
    hash-table)
(defun replay-run (run-dir)
  "Regrade archived samples offline and save a report without changing old scores."
  (let* ((run-dir (uiop:ensure-directory-pathname run-dir))
         (info (read-json (at run-dir "manifest.json")))
         (cases (sequence-list
                 (read-json (at (at run-dir "harness/")
                                (concatenate 'string
                                             (suite-path (or (field info "suite") "writing-common-lisp"))
                                             "selected-cases.json")))))
         (40ants-ai-evals/case-resources:*inputs-root* (at run-dir "harness/"))
         (report nil))
    (dolist (dir (uiop:subdirectories (at run-dir "samples/")))
      (let* ((sample (read-json (at dir "sample.json")))
             (id (field sample "sampleId"))
             (case (find-if (lambda (case)
                              (or (equal (field sample "case") (field case "vars" "id"))
                                  (uiop:string-prefix-p
                                   (format nil "~A-~A-" (field case "vars" "id")
                                           (field sample "variant")) id))) cases)))
        (unless case (error "Cannot map archived sample to a test case: ~A" id))
        (setf (gethash "suite" (field case "vars"))
              (or (field info "suite") "writing-common-lisp"))
        (let ((integrity (or (archive-integrity-error sample dir)
                             (when (probe-file (at dir "turn.json"))
                               (40ants-ai-evals/collector::blocked-mcp-error (read-json (at dir "turn.json"))))
                             (when (unavailable-native-results-p sample)
                               "Native MCP results unavailable in archived nested tool calls"))))
          (push (dict "sampleId" id
                    "infrastructureError" (or integrity :null)
                    "missingEvidence" (coerce (remove-if
                                               (lambda (key) (nth-value 1 (gethash key sample)))
                                               (append '("toolCalls" "artifacts" "environment")
                                                       (when (unavailable-native-results-p sample)
                                                         '("nativeMcpResults")))) 'vector)
                    "grading" (if integrity
                                  (dict "pass" 'yason:false "score" 0 "reason" integrity)
                                  (40ants-ai-evals/grading/contracts:grade
                                   sample (grading-vars (field case "vars"))
                                   :sample-directory dir))) report))))
    (let ((result (dict "runId" (field info "id") "replayedAt" (now)
                        "graderSuiteHash" (grader-fingerprint)
                        "samples" (coerce (nreverse report) 'vector))))
      (write-json (at run-dir "replay-lisp.json") result)
      result)))


(-> run-eval (hash-table)
    integer)
(defun run-eval (flags)
  "Evaluate suites separately; retain a durable index for multi-suite batches."
  (validate-options flags)
  (let* ((entries (selected-suites flags))
         (batch-id (when (> (length entries) 1) (unique-id)))
         (batch-file (when batch-id (at (root) (format nil ".evals/batches/~A.json" batch-id))))
         (rows nil) (status 0))
    ;; Validate every selected case plan before any paid run begins.
    (dolist (entry entries)
      (let* ((child (40ants-ai-evals/checks:merge-vars flags (dict "suite" (field entry "id"))))
             (*skill-path* (field entry "skillPath"))
             (*suite-path* (suite-path (field entry "id"))))
        (selected-cases child)))
    (dolist (entry entries)
      (let* ((child (40ants-ai-evals/checks:merge-vars flags (dict "suite" (field entry "id"))))
             (*skill-path* (field entry "skillPath"))
             (*suite-path* (suite-path (field entry "id")))
             (before (uiop:subdirectories (at (root) ".evals/runs/")))
             (code (handler-case (run-single-eval child)
                     (error (condition)
                       (format *error-output* "Suite ~A failed: ~A~%" (field entry "id") condition)
                       2)))
             (created (set-difference (uiop:subdirectories (at (root) ".evals/runs/")) before
                                      :test #'equal)))
        (unless (zerop code) (setf status 1))
        (push (dict "suite" (field entry "id") "status" code
                    "runIds" (map 'vector (lambda (dir)
                                            (car (last (pathname-directory dir)))) created)) rows)
        (when batch-file
          (write-json batch-file
                      (dict "id" batch-id "updatedAt" (now)
                            "complete" (if (= (length rows) (length entries)) 'yason:true 'yason:false)
                            "suites" (coerce (reverse rows) 'vector))))))
    (when batch-file (format t "Batch: ~A~%" batch-file))
    status))
